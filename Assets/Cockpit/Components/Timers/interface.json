    "count_directions": [
      "up",
      "down"
    ],
    "clock_policy": "new app-local timer state driven by simulation timestamp; no existing AGC event timer channel",
    "endpoint_policy": "Later behavior documented Apollo13 MSC02680 pA-2: reaching zero in countdown changes effective count direction to UP and continues; up59:59 wraps00:00 per1967 DataBook. This reconstruction combines documented revisions, not Apollo11 qualification.",
    "countdown_display": "state owner supplies whole seconds; no model-local clock",
    "reset_policy": "Momentary RESET sets00:00 and stops untilSTART; physical release returnscenter. App retains explicit selecteddirection separately fromneutralleverpose.",
    "slew_policy": "Independent tens/units digits increment2Hz while held, all increase regardless count direction. Tens wrap0..5, units0..9 with no adjacent carry. Runtime uses simulation timestamps and explicit press/release.",
    "source_revision": "LM event timer control topology:1967 DataBook rev2 p4-63; downzero:autoUP NASA Apollo13 Mission Report September1970 pA-2.",
    "direction_input_policy": "ExplicitUP/DOWN user command changes appselecteddirection; releasing momentaryDOWN tocenter does not issueUP. This command/pose separation is an app interaction policy, not an asserted electrical circuit."
  },
